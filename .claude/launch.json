{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poon-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "poon-web-qa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "poon-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "design-study",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/design-study"
      ],
      "port": 4321
    }
  ]
}
